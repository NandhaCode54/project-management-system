# Server environment variables
# Copy to .env and adjust as needed.

NODE_ENV=development
PORT=5000

# PostgreSQL connection string (docker-compose defaults shown)
DATABASE_URL="postgresql://pms:pms_password@localhost:5432/pms?schema=public"

# Test database — used only when NODE_ENV=test
TEST_DATABASE_URL="postgresql://pms:pms_password@localhost:5432/pms_test?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"
# Cookie lifetime in milliseconds (default 1 day)
JWT_COOKIE_MAX_AGE=86400000
# Cookie names
AUTH_COOKIE_NAME="pms_token"

# CORS: comma-separated list of allowed origins
CLIENT_ORIGINS="http://localhost:5173"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300